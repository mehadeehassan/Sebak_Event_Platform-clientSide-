# Copy this file to .env.local and fill in your own values.

# Base URL of the Express api server that stores events and joins (no trailing
# slash). BetterAuth itself is served by this app at /api/auth.
NEXT_PUBLIC_API_URL=http://localhost:5000

# MongoDB — the auth database (users, sessions, jwks) lives in the same
# database the API server uses.
DB_NAME=sebak
MONGODB_URI=mongodb+srv://<user>:<password>@<host>/?retryWrites=true&w=majority

# Secret used to sign the BetterAuth session cookies and JWT keys.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=replace-with-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000

# Google Cloud Console → Credentials → OAuth client
# Redirect URI to whitelist: <your app origin>/api/auth/callback/google
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
